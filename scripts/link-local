#!/bin/bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PLUGIN_ID=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["id"])' "$ROOT_DIR/manifest.json")
PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
TARGET="$PLUGINS_DIR/$PLUGIN_ID"

if [[ -e $TARGET || -L $TARGET ]]; then
  echo "link-local: target already exists: $TARGET" >&2
  echo "Remove the existing plugin first with: omarchy plugin remove $PLUGIN_ID" >&2
  exit 1
fi

"$ROOT_DIR/scripts/check"
mkdir -p "$PLUGINS_DIR"
ln -s "$ROOT_DIR" "$TARGET"

echo "Linked $PLUGIN_ID -> $ROOT_DIR"

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins >/dev/null
  echo "Rescanned Omarchy plugins."
fi

echo "Enable it with: omarchy plugin enable $PLUGIN_ID --section right"
echo "Remove only the link with: omarchy plugin remove $PLUGIN_ID"

