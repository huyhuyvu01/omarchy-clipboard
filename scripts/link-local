#!/bin/bash

set -euo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
PLUGIN_ID=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["id"])' "$ROOT_DIR/manifest.json")
PLUGINS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
TARGET="$PLUGINS_DIR/$PLUGIN_ID"
RELOAD=0

usage() {
  echo "Usage: $0 [--reload]"
}

while (( $# > 0 )); do
  case "$1" in
  --reload)
    RELOAD=1
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "link-local: unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
  esac
done

if [[ -e $TARGET || -L $TARGET ]]; then
  if (( ! RELOAD )); then
    echo "link-local: target already exists: $TARGET" >&2
    echo "Run $0 --reload to unlink and relink the local plugin." >&2
    exit 1
  fi

  if [[ ! -L $TARGET ]]; then
    echo "link-local: refusing to reload a target that is not a symlink: $TARGET" >&2
    exit 1
  fi

  command -v omarchy >/dev/null 2>&1 || {
    echo "link-local: omarchy is required to reload an existing plugin" >&2
    exit 1
  }

  omarchy plugin disable "$PLUGIN_ID"
  omarchy plugin remove "$PLUGIN_ID" --yes
fi

"$ROOT_DIR/scripts/check"
mkdir -p "$PLUGINS_DIR"
ln -s "$ROOT_DIR" "$TARGET"

echo "Linked $PLUGIN_ID -> $ROOT_DIR"

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins >/dev/null
  echo "Rescanned Omarchy plugins."
fi

if (( RELOAD )); then
  omarchy plugin enable "$PLUGIN_ID"
else
  echo "Enable it with: omarchy plugin enable $PLUGIN_ID --section right"
fi
echo "Remove only the link with: omarchy plugin remove $PLUGIN_ID"
